# Copie este arquivo para .env e preencha com seus valores
# Chave gerada em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODELO=gemini-3.8-flash
# Usado na segunda tentativa quando o modelo principal cai, estoura o limite ou responde fora do JSON
GEMINI_MODELO_RESERVA=gemini-3.1-flash-lite
GEMINI_TIMEOUT=25
GEMINI_TIMEOUT_PRINCIPAL=15

NOME_EMPRESA=SHUI
LIMITE_REQUISICOES_POR_MINUTO=15

# Libera os botões de teste de falhas no painel Resiliência (use true só na apresentação)
MODO_DEMONSTRACAO=false

# Força uma falha em todas as mensagens: timeout, limite, fora_do_ar ou json_invalido (deixe vazio para uso normal)
SIMULAR_FALHA=
